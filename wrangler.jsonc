{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "design-agent-eval-loop",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/relay"]
  },
  "observability": {
    "enabled": true
  }
}
